{
  "components": {
    "headers": {
      "RequestId": {
        "description": "Opaque request correlation identifier",
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "in": "header",
        "name": "Idempotency-Key",
        "required": true,
        "schema": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[!-~]+$",
          "type": "string"
        }
      },
      "JobId": {
        "in": "path",
        "name": "job_id",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/JobId"
        }
      },
      "UploadId": {
        "in": "path",
        "name": "upload_id",
        "required": true,
        "schema": {
          "$ref": "#/components/schemas/UploadId"
        }
      }
    },
    "responses": {
      "BadRequest": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Conflict": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "ErrorResponse": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        },
        "description": "Stable content-free error",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "Job": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JobResponse"
            }
          }
        },
        "description": "Tenant-scoped job state",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "NotFound": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "ServiceUnavailable": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Unauthorized": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "Unprocessable": {
        "$ref": "#/components/responses/ErrorResponse"
      },
      "UploadCompletion": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UploadCompletionResponse"
            }
          }
        },
        "description": "Upload generation recorded for inspection",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      },
      "UploadIntent": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/UploadIntentResponse"
            }
          }
        },
        "description": "New or replayed upload reservation",
        "headers": {
          "X-Request-ID": {
            "$ref": "#/components/headers/RequestId"
          }
        }
      }
    },
    "schemas": {
      "CreateJobRequest": {
        "$ref": "./create-job.schema.json"
      },
      "CreateUploadRequest": {
        "additionalProperties": false,
        "properties": {
          "content_length": {
            "maximum": 104857600,
            "minimum": 1,
            "type": "integer"
          },
          "content_type": {
            "enum": [
              "application/pdf",
              "image/jpeg",
              "image/png",
              "image/tiff",
              "image/webp"
            ],
            "type": "string"
          },
          "sha256": {
            "$ref": "#/components/schemas/Digest"
          }
        },
        "required": [
          "content_type",
          "content_length",
          "sha256"
        ],
        "type": "object"
      },
      "Digest": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
      },
      "Error": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "message": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "request_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "type": "object"
      },
      "JobId": {
        "pattern": "^job_[A-Za-z0-9_]{1,64}$",
        "type": "string"
      },
      "JobResponse": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "format": "date-time",
            "type": "string"
          },
          "job_id": {
            "$ref": "#/components/schemas/JobId"
          },
          "result_url": {
            "pattern": "^/v1/ocr/jobs/job_[A-Za-z0-9_]{1,64}/result$",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "status_url": {
            "pattern": "^/v1/ocr/jobs/job_[A-Za-z0-9_]{1,64}$",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "status",
          "created_at"
        ],
        "type": "object"
      },
      "JobStatus": {
        "enum": [
          "accepted",
          "inspecting",
          "processing",
          "validating",
          "cancelling",
          "cancelled",
          "rejected",
          "partial",
          "review_required",
          "completed"
        ],
        "type": "string"
      },
      "UploadCompletionResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "uploaded"
          },
          "upload_id": {
            "$ref": "#/components/schemas/UploadId"
          }
        },
        "required": [
          "upload_id",
          "status"
        ],
        "type": "object"
      },
      "UploadId": {
        "pattern": "^upl_[A-Za-z0-9_]{1,64}$",
        "type": "string"
      },
      "UploadIntentResponse": {
        "additionalProperties": false,
        "properties": {
          "expires_at": {
            "format": "date-time",
            "type": "string"
          },
          "method": {
            "const": "PUT"
          },
          "required_headers": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 8,
            "type": "object"
          },
          "upload_id": {
            "$ref": "#/components/schemas/UploadId"
          },
          "upload_url": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          }
        },
        "required": [
          "upload_id",
          "method",
          "upload_url",
          "required_headers",
          "expires_at"
        ],
        "type": "object"
      },
      "WebhookSubscriptionId": {
        "pattern": "^whs_[A-Za-z0-9_]{1,64}$",
        "type": "string"
      }
    },
    "securitySchemes": {
      "workloadIdentity": {
        "description": "The trusted gateway maps the authenticated workload or user to product and tenant scope. Identity is never accepted from request JSON.",
        "type": "mutualTLS"
      }
    }
  },
  "info": {
    "description": "Provider-neutral, multi-tenant document processing. Document content is always untrusted data.",
    "title": "Tesserix Document Intelligence API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process is alive",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          }
        },
        "security": []
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readiness",
        "responses": {
          "200": {
            "description": "Required dependencies are configured and reachable",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        },
        "security": []
      }
    },
    "/v1/ocr/jobs": {
      "post": {
        "operationId": "createJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateJobRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Job"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/ocr/jobs/{job_id}": {
      "get": {
        "operationId": "getJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Job"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/ocr/jobs/{job_id}/cancel": {
      "post": {
        "operationId": "cancelJob",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Job"
          },
          "202": {
            "$ref": "#/components/responses/Job"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/ocr/jobs/{job_id}/result": {
      "get": {
        "operationId": "getJobResult",
        "parameters": [
          {
            "$ref": "#/components/parameters/JobId"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./document-result.schema.json"
                }
              }
            },
            "description": "Immutable, evidence-backed document result",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestId"
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/ocr/uploads": {
      "post": {
        "operationId": "createUploadIntent",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/UploadIntent"
          },
          "201": {
            "$ref": "#/components/responses/UploadIntent"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    },
    "/v1/ocr/uploads/{upload_id}/complete": {
      "post": {
        "operationId": "completeUpload",
        "parameters": [
          {
            "$ref": "#/components/parameters/UploadId"
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/UploadCompletion"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/Unprocessable"
          },
          "503": {
            "$ref": "#/components/responses/ServiceUnavailable"
          }
        }
      }
    }
  },
  "security": [
    {
      "workloadIdentity": []
    }
  ],
  "servers": [
    {
      "url": "/"
    }
  ]
}
