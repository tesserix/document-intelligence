ARG RUST_BUILDER=rust:1.94-slim-bookworm@sha256:cf9dd0ec73e75f827fe59123fff9dc65af1a1c8363c3c31ee8d7f8ad0b6a5fb2
ARG TESSERIX_RUNTIME=ghcr.io/tesserix/base-debian-runtime:20261003@sha256:b687ab8631e6cfbc342c210bc56996c311cc4fac4223df33dfa768d588faf834

FROM ${RUST_BUILDER} AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
RUN cargo build --locked --release -p ocr-parser-sandbox --bin ocr-parser-sandbox

FROM ${TESSERIX_RUNTIME}
COPY --from=build --chown=10001:10001 /src/target/release/ocr-parser-sandbox /app/ocr-parser-sandbox
ENTRYPOINT ["/usr/bin/tini", "--", "/app/ocr-parser-sandbox"]
